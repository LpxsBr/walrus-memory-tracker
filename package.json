{
  "name": "walrus-memory-tracker",
  "version": "1.1.0",
  "description": "Make device memory tracker",
  "main": "build/WalrusMemoryTrackerModule.js",
  "types": "build/WalrusMemoryTracker.types.d.ts",
  "scripts": {
    "build": "node build-simple.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "prepublishOnly": "npm run build && npm run lint",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "files": [
    "build/",
    "src/",
    "ios/",
    "android/",
    "expo-module.config.json"
  ],
  "keywords": [
    "react-native",
    "expo",
    "walrus-memory-tracker",
    "WalrusMemoryTracker"
  ],
  "repository": "https://github.com/LpxsBr/walrus-memory-tracker",
  "bugs": {
    "url": "https://github.com/LpxsBr/walrus-memory-tracker/issues"
  },
  "author": "LpxsBr <anselmolopes.an@gmail.com> (https://github.com/LpxsBr)",
  "license": "MIT",
  "homepage": "https://github.com/LpxsBr/walrus-memory-tracker#readme",
  "dependencies": {
    "expo": "*",
    "react": "*",
    "react-native": ">=0.86.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.1.1",
    "babel-preset-expo": "~55.0.8",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "^57.0.11",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.9",
    "prettier": "^3.0.0",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*"
  }
}
